# Copier en .env (ou définir ces variables dans le terminal) si besoin.
# Toutes ont une valeur par défaut : le projet fonctionne sans .env.

# URL de l'API utilisée par le frontend Streamlit
CLINIQUE_API_URL=http://127.0.0.1:8000

# Base de données (SQLite par défaut, à la racine du projet)
# CLINIQUE_DATABASE_URL=sqlite:///D:/claude/clinique-sante-plus/clinique.db

# Mot de passe des comptes de démonstration créés par backend/seed_data.py
CLINIQUE_DEMO_PASSWORD=Demo2026!

# Windows uniquement : dossier contenant bin/winutils.exe pour Spark
# HADOOP_HOME=D:\hadoop

# ---------------------------------------------------------------
# Assistant IA (gratuit) — choisissez UN fournisseur
# ---------------------------------------------------------------
# groq (défaut)  : clé gratuite sans carte bancaire -> https://console.groq.com/keys
# gemini         : clé gratuite Google AI Studio    -> https://aistudio.google.com/apikey
# openrouter     : modèles « :free »                 -> https://openrouter.ai/keys
# ollama         : modèle local, aucune clé          -> https://ollama.com
ASSISTANT_PROVIDER=groq
GROQ_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=

# Optionnel : forcer un modèle précis (sinon valeur par défaut du fournisseur)
# ASSISTANT_MODEL=openai/gpt-oss-120b
